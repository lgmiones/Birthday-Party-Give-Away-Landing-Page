# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Unused source photography — only the files actually rendered by the page
# (HeroSection + AboutBolderSection) are tracked. The rest of this folder is
# the original Bolder Adventure Park asset dump and is kept local only, so
# it stays out of the public repo and doesn't bloat clone size.
# Delete this section if you decide to use more of the source photos later.
# ---------------------------------------------------------------------------
/public/images/After-hero-section/
/public/images/Base-Camp/
/public/images/Extreme All Access/
/public/images/MJ Dejavu/
/public/images/Summit/
/public/images/Ticketing pic/
/public/images/videos/
/public/images/carousel-images/

# All 12 attraction photos are used by AttractionMarquee.tsx, so the whole
# folder is tracked (untouched by the exclusions above) — nothing to ignore
# here anymore.

/public/images/images/*
!/public/images/images/bolder-logo.png
!/public/images/images/Reviews-birthday-parties.jpg

# Superseded illustrations and photo sections — kept locally for reference,
# no longer imported by app/page.tsx now that the page has been trimmed down
# to a lean, single-offer giveaway funnel (see Navbar.tsx, BenefitsSection.tsx,
# HowItWorksSection.tsx, SocialProofSection.tsx — unused but left in place).
/public/images/gallery-*.svg
/public/images/hero-birthday-party.svg
